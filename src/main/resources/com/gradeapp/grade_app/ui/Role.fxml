<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.image.Image?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>

<BorderPane xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.gradeapp.grade_app.controllers.ChooseController" prefWidth="800" prefHeight="600"  style= "-fx-padding: 20;">

    <top>
        <Label fx:id="chooseRole" text="Choose your role:" wrapText="true" BorderPane.alignment="CENTER" styleClass="header-label"/>
    </top>

    <center>
        <HBox alignment="CENTER" spacing="60">
            <Button fx:id="studentButton" text="Student" contentDisplay="BOTTOM" onAction="#studentLogin">
            </Button>

            <Button fx:id="teacherButton" text="Teacher" contentDisplay="BOTTOM" onAction="#teacherLogin">
            </Button>

            <Button fx:id="adminButton" text="Admin" contentDisplay="BOTTOM" onAction="#adminLogin">
            </Button>
        </HBox>
    </center>

</BorderPane>