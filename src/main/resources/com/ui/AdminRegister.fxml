               <image>
                  <Image url="@/logo.png" />
               </image>
            </ImageView>
            <Button fx:id="insertButton" layoutY="239.0" mnemonicParsing="false" onAction="#adminRegister" prefHeight="49.0" prefWidth="241.0" text="INSERT" />
            <Button fx:id="deleteButton" layoutX="-2.0" layoutY="287.0" mnemonicParsing="false" onAction="#adminDelete" prefHeight="46.0" prefWidth="244.0" text="DELETE" />
            <Button fx:id="assignButton" layoutY="333.0" mnemonicParsing="false" onAction="#adminAssign" prefHeight="48.0" prefWidth="242.0" text="ASSIGN/DELETE" />
            <Button fx:id="logOutButton" layoutX="-1.0" layoutY="542.0" mnemonicParsing="false" onAction="#logOut" prefHeight="42.0" prefWidth="243.0" text="LOG OUT" />
            <Button fx:id="subjectButton" layoutY="381.0" mnemonicParsing="false" onAction="#adminSubject" prefHeight="49.0" prefWidth="241.0" text="SUBJECT" />
