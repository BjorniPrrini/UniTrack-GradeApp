<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.RadioButton?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>


<VBox fx:id="assignCenterVbox" alignment="CENTER" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="600.0" prefWidth="750.0" spacing="20.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1">
   <children>
      <TextField fx:id="teacherNameField" maxHeight="-Infinity" maxWidth="-Infinity" prefHeight="35.0" prefWidth="353.0" promptText="Enter name...." />
      <TextField fx:id="teacherSurnameField" maxHeight="-Infinity" maxWidth="-Infinity" prefHeight="36.0" prefWidth="349.0" promptText="Enter surname...." />
      <HBox alignment="CENTER" prefHeight="45.0" prefWidth="750.0" spacing="20.0">
         <children>
            <RadioButton fx:id="addRadio" mnemonicParsing="false" text="ADD">
               <toggleGroup>
                  <ToggleGroup fx:id="optionToggleGroup" />
               </toggleGroup>
            </RadioButton>
            <RadioButton fx:id="deleteRadio" mnemonicParsing="false" text="DELETE" toggleGroup="$optionToggleGroup" />
            <Button fx:id="loadSubjectButton" mnemonicParsing="false" prefHeight="33.0" prefWidth="185.0" text="Load Subjects" />
         </children>
      </HBox>
      <ComboBox fx:id="subjectComboBox" prefHeight="31.0" prefWidth="302.0" promptText="Subjects">
         <VBox.margin>
            <Insets top="50.0" />
         </VBox.margin>
      </ComboBox>
      <Button fx:id="submitButton" mnemonicParsing="false" prefHeight="38.0" prefWidth="167.0" text="Submit">
         <VBox.margin>
            <Insets top="30.0" />
         </VBox.margin>
      </Button>
   </children>
</VBox>
